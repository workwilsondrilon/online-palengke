{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },

  // Matches the credentials in docker-compose.yml. Local-only — this database is
  // disposable and holds nothing real.
  //
  // Port 3307, not the default 3306: this machine already has a host-installed
  // MySQL bound to 3306, so docker-compose.yml is brought up with
  // MYSQL_HOST_PORT=3307 (see README.Database.md). Change this back to 3306 if
  // your machine does not have that conflict.
  "Database": {
    "ConnectionString": "Server=localhost;Port=3307;Database=onlinepalengke;User ID=palengke;Password=palengke;AllowUserVariables=true;UseAffectedRows=false"
  },

  // Bucket names are per-developer, since object storage is real AWS S3 in every
  // environment. Set these with user-secrets rather than editing this file:
  //   dotnet user-secrets set "Storage:PublicBucket" "palengke-dev-<you>-public"
  //   dotnet user-secrets set "Storage:PrivateBucket" "palengke-dev-<you>-private"
  // AWS credentials come from the standard chain (environment or shared profile) and
  // must never be placed in configuration.
  "Storage": {
    "Region": "ap-southeast-1",
    "PublicBucket": "palengke-dev-public",
    "PrivateBucket": "palengke-dev-private"
  },

  // Lets local clients and integration tests present an identity before phone-OTP
  // authentication exists. Send X-Dev-User-Id and X-Dev-Role with each request.
  // Has no effect outside the Development environment.
  "Auth": {
    "EnableDevHeaderScheme": true
  }
}
