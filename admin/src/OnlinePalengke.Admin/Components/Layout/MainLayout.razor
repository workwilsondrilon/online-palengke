@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="shell @(_navOpen ? "shell--nav-open" : null)">
    <div class="shell__sidebar" id="primary-nav">
        <NavMenu />
    </div>

    <div class="shell__scrim" @onclick="CloseNav" aria-hidden="true"></div>

    <div class="shell__main">
        <header class="topbar">
            <button type="button"
                    class="topbar__toggle"
                    aria-controls="primary-nav"
                    aria-expanded="@(_navOpen ? "true" : "false")"
                    aria-label="@(_navOpen ? "Close navigation" : "Open navigation")"
                    @onclick="ToggleNav">
                <span aria-hidden="true">☰</span>
            </button>

            <div class="topbar__clock">
                <span class="topbar__clock-date">@ManilaTime.FormatDate(ManilaTime.Today)</span>
                <span class="topbar__clock-zone">Asia/Manila · @ManilaTime.Abbreviation</span>
            </div>

            <div class="topbar__spacer"></div>

            <div class="topbar__user">
                @* Placeholder only. The project was scaffolded with --auth None; sign-in is wired later. *@
                <span class="topbar__avatar" aria-hidden="true">OA</span>
                <span class="topbar__user-text">
                    <span class="topbar__user-name">Ops Administrator</span>
                    <span class="topbar__user-role">Signed-in user placeholder</span>
                </span>
            </div>
        </header>

        <main class="shell__content" id="main-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navOpen;

    protected override void OnInitialized() =>
        Navigation.LocationChanged += HandleLocationChanged;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_navOpen)
        {
            return;
        }

        _navOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() =>
        Navigation.LocationChanged -= HandleLocationChanged;
}
