@page "/orders"

<PageTitle>Orders · Online Palengke Admin</PageTitle>

<PageHeader Title="Orders"
            Description="Every shopping list from the moment it is posted for bidding through to delivery. Search by reference, customer or market.">
    <Actions>
        <button type="button" class="op-btn" disabled>Export CSV</button>
    </Actions>
</PageHeader>

<DataPanel Title="All orders"
           Caption="Customer orders with status and total"
           IsEmpty="@(_filtered.Count == 0)">
    <Toolbar>
        <div class="search">
            <span class="search__glyph" aria-hidden="true">⌕</span>
            <label class="visually-hidden" for="order-search">Search orders</label>
            <input id="order-search"
                   class="field__control"
                   type="search"
                   placeholder="Reference, customer or market"
                   value="@_query"
                   @oninput="OnQueryChanged" />
        </div>
        <FilterChips Label="Filter by status"
                     Chips="PlaceholderData.OrderFilters"
                     Selected="@_status"
                     SelectedChanged="OnStatusChanged" />
    </Toolbar>
    <Columns>
        <th scope="col">Reference</th>
        <th scope="col">Customer</th>
        <th scope="col">Market and window</th>
        <th scope="col">Placed</th>
        <th scope="col" class="num">Lines</th>
        <th scope="col" class="num">Total</th>
        <th scope="col">Status</th>
        <th scope="col" class="actions">Actions</th>
    </Columns>
    <EmptyContent>
        <EmptyState Glyph="▤"
                    Title="@EmptyTitle"
                    Description="Orders appear the moment a customer posts a shopping list, well before any money changes hands." />
    </EmptyContent>
    <ChildContent>
        @foreach (var order in _filtered)
        {
            <tr>
                <td><a class="mono cell-strong" href="@($"orders/{order.Reference}")">@order.Reference</a></td>
                <td>@order.CustomerName</td>
                <td>
                    @order.MarketName
                    <span class="cell-sub">@order.WindowLabel · @ManilaTime.FormatDate(order.DeliveryDate)</span>
                </td>
                <td>
                    <ManilaTimestamp ValueUtc="order.PlacedAtUtc" Relative="true" />
                    <span class="cell-sub"><ManilaTimestamp ValueUtc="order.PlacedAtUtc" /></span>
                </td>
                <td class="num">@order.LineCount</td>
                <td class="num">
                    @if (order.Total == 0m)
                    {
                        <span class="cell-sub">Not priced yet</span>
                    }
                    else
                    {
                        <PhpAmount Value="order.Total" />
                    }
                </td>
                <td><StatusBadge Status="@order.Status" /></td>
                <td class="actions">
                    <div class="btn-row">
                        <a class="op-btn op-btn--sm" href="@($"orders/{order.Reference}")">Open</a>
                    </div>
                </td>
            </tr>
        }
    </ChildContent>
    <Footer>
        Showing @_filtered.Count of @PlaceholderData.Orders.Count orders. Totals are PHP and include the delivery fee.
    </Footer>
</DataPanel>

@code {
    private string _query = string.Empty;
    private string _status = "all";
    private IReadOnlyList<OrderRow> _filtered = PlaceholderData.Orders;

    private string EmptyTitle => string.IsNullOrWhiteSpace(_query) && _status == "all"
        ? "No orders yet"
        : "No orders match those filters";

    private void OnQueryChanged(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        Apply();
    }

    private void OnStatusChanged(string status)
    {
        _status = status;
        Apply();
    }

    private void Apply()
    {
        IEnumerable<OrderRow> query = PlaceholderData.Orders;

        if (_status != "all")
        {
            query = query.Where(o => Slug(o.Status) == _status);
        }

        if (!string.IsNullOrWhiteSpace(_query))
        {
            var term = _query.Trim();
            query = query.Where(o =>
                o.Reference.Contains(term, StringComparison.OrdinalIgnoreCase)
                || o.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || o.MarketName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        _filtered = query.ToList();
    }

    private static string Slug(string status) =>
        status.Trim().ToLowerInvariant().Replace(' ', '-');
}
