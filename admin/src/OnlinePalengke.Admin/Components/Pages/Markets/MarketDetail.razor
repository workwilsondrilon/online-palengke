@page "/markets/{MarketId:long}"
@attribute [Authorize]
@inject AdminApiClient Api

<PageTitle>@(_market?.Name ?? "Market") · Online Palengke Admin</PageTitle>

@if (_notFound)
{
    <PageHeader Title="Market not found">
        <Breadcrumb>
            <a href="markets">Markets</a> Not found
        </Breadcrumb>
    </PageHeader>

    <div class="panel">
        <div class="panel__body">
            <EmptyState Glyph="⌂"
                        Title="That market does not exist"
                        Description="No market carries that id. The link may be stale.">
                <Actions>
                    <a class="op-btn op-btn--primary" href="markets">Back to markets</a>
                </Actions>
            </EmptyState>
        </div>
    </div>
}
else if (_market is { } market)
{
    <PageHeader Title="@market.Name" Description="@($"{market.City}, {market.Province}")">
        <Breadcrumb>
            <a href="markets">Markets</a> @market.Name
        </Breadcrumb>
        <Actions>
            <StatusBadge Status="@market.Status" />
            <button type="button" class="op-btn" @onclick="OpenEditMarket">Edit market</button>
        </Actions>
    </PageHeader>

    @if (_error is not null)
    {
        <div class="notice notice--error" role="alert">
            <span class="notice__glyph" aria-hidden="true">⚠</span>
            <span>@_error</span>
        </div>
    }

    <div class="col-2 col-2--wide-first">
        <div class="stack">
            <section class="panel">
                <div class="panel__head">
                    <div class="panel__headings">
                        <h2 class="panel__title">Delivery service area</h2>
                        <p class="panel__description">
                            The polygon a customer's address must fall inside to order from this market.
                            Drawn and edited with Leaflet.draw.
                        </p>
                    </div>
                    <div class="panel__toolbar">
                        <button type="button" class="op-btn op-btn--sm" @onclick="ClearArea" disabled="@_savingArea">Clear</button>
                        <button type="button" class="op-btn op-btn--sm op-btn--primary" @onclick="SaveAreaAsync" disabled="@_savingArea">
                            @(_savingArea ? "Saving…" : "Save area")
                        </button>
                    </div>
                </div>
                <div class="panel__body">
                    <ServiceAreaMap MarketId="market.Id"
                                    InitialPolygonGeoJson="@_pendingGeoJson"
                                    OnPolygonChanged="OnPolygonChanged" />
                </div>
            </section>

            <DataPanel Title="Delivery windows"
                       Description="Times are Asia/Manila wall-clock. The cutoff is how long before the window opens that ordering — and therefore quoting — closes."
                       Caption="Delivery windows for this market"
                       IsEmpty="@(_windows.Count == 0)">
                <Toolbar>
                    <button type="button" class="op-btn op-btn--sm op-btn--primary" @onclick="OpenCreateWindow">Add window</button>
                </Toolbar>
                <Columns>
                    <th scope="col">Label</th>
                    <th scope="col">Opens</th>
                    <th scope="col">Closes</th>
                    <th scope="col" class="num">Cutoff</th>
                    <th scope="col" class="num">Capacity</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="actions">Actions</th>
                </Columns>
                <EmptyContent>
                    <EmptyState Glyph="◷"
                                Title="No delivery windows for this market yet"
                                Description="Customers cannot book until at least one window exists. A typical first window is 7–9 AM with a 90 minute cutoff." />
                </EmptyContent>
                <ChildContent>
                    @foreach (var window in _windows)
                    {
                        <tr>
                            <td class="cell-strong">@window.Label</td>
                            <td>@ManilaTime.FormatTimeOfDay(window.StartsAt)</td>
                            <td>@ManilaTime.FormatTimeOfDay(window.EndsAt)</td>
                            <td class="num">@window.CutoffOffsetMinutes min before</td>
                            <td class="num">@window.Capacity</td>
                            <td><StatusBadge Status="@(window.IsActive ? "Active" : "Inactive")" /></td>
                            <td class="actions">
                                <div class="btn-row">
                                    <button type="button" class="op-btn op-btn--sm" @onclick="() => OpenEditWindow(window)">Edit</button>
                                    <button type="button" class="op-btn op-btn--sm" @onclick="() => ConfirmRemove(window)">Remove</button>
                                </div>
                            </td>
                        </tr>
                    }
                </ChildContent>
            </DataPanel>
        </div>

        <div class="stack">
            <section class="panel">
                <div class="panel__head">
                    <div class="panel__headings">
                        <h2 class="panel__title">At a glance</h2>
                    </div>
                </div>
                <div class="panel__body">
                    <dl class="detail-list">
                        <dt>Market id</dt>
                        <dd class="mono">@market.Id</dd>

                        <dt>Address</dt>
                        <dd>@market.Address</dd>

                        <dt>City</dt>
                        <dd>@market.City</dd>

                        <dt>Province</dt>
                        <dd>@market.Province</dd>

                        <dt>Delivery windows</dt>
                        <dd>@_windows.Count</dd>

                        <dt>Service area</dt>
                        <dd>
                            <StatusBadge Status="@(market.HasServiceArea ? "Active" : "Pending")"
                                         Label="@(market.HasServiceArea ? "Drawn" : "Not drawn")" />
                        </dd>

                        <dt>Status</dt>
                        <dd><StatusBadge Status="@market.Status" /></dd>
                    </dl>
                </div>
            </section>
        </div>
    </div>

    <ConfirmDialog @ref="_confirmDialog" OnConfirm="HandleRemoveConfirmed" />

    @if (_showMarketForm)
    {
        <div class="op-modal-layer">
            <div class="op-modal-backdrop" @onclick="CloseMarketForm"></div>
            <div class="op-modal" role="dialog" aria-modal="true" aria-labelledby="market-edit-title">
                <h2 class="op-modal__title" id="market-edit-title">Edit market</h2>

                @if (_formError is not null)
                {
                    <div class="notice notice--error" role="alert">
                        <span class="notice__glyph" aria-hidden="true">⚠</span>
                        <span>@_formError</span>
                    </div>
                }

                <div class="field">
                    <label class="field__label" for="market-edit-name">Name</label>
                    <input id="market-edit-name" class="field__control" @bind="_formName" @bind:event="oninput" disabled="@_saving" />
                </div>

                <div class="field">
                    <label class="field__label" for="market-edit-address">Address</label>
                    <input id="market-edit-address" class="field__control" @bind="_formAddress" @bind:event="oninput" disabled="@_saving" />
                </div>

                <div class="field-grid">
                    <div class="field">
                        <label class="field__label" for="market-edit-city">City</label>
                        <input id="market-edit-city" class="field__control" @bind="_formCity" @bind:event="oninput" disabled="@_saving" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="market-edit-province">Province</label>
                        <input id="market-edit-province" class="field__control" @bind="_formProvince" @bind:event="oninput" disabled="@_saving" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="market-edit-lat">Latitude</label>
                        <input id="market-edit-lat" class="field__control" type="number" step="0.000001" @bind="_formLat" disabled="@_saving" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="market-edit-lng">Longitude</label>
                        <input id="market-edit-lng" class="field__control" type="number" step="0.000001" @bind="_formLng" disabled="@_saving" />
                    </div>
                </div>

                <div class="field">
                    <label class="field__label" for="market-edit-status">Status</label>
                    <select id="market-edit-status" class="field__control" @bind="_formStatus" disabled="@_saving">
                        <option value="onboarding">Onboarding</option>
                        <option value="active">Active</option>
                        <option value="suspended">Suspended</option>
                    </select>
                    <span class="field__hint">Activating requires a saved delivery service area.</span>
                </div>

                <div class="op-modal__actions">
                    <button type="button" class="op-btn op-btn--ghost" @onclick="CloseMarketForm" disabled="@_saving">Cancel</button>
                    <button type="button" class="op-btn op-btn--primary" @onclick="SaveMarketAsync" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showWindowForm)
    {
        <div class="op-modal-layer">
            <div class="op-modal-backdrop" @onclick="CloseWindowForm"></div>
            <div class="op-modal" role="dialog" aria-modal="true" aria-labelledby="window-form-title">
                <h2 class="op-modal__title" id="window-form-title">@(_editingWindowId is null ? "Add delivery window" : "Edit delivery window")</h2>

                @if (_formError is not null)
                {
                    <div class="notice notice--error" role="alert">
                        <span class="notice__glyph" aria-hidden="true">⚠</span>
                        <span>@_formError</span>
                    </div>
                }

                <div class="field">
                    <label class="field__label" for="window-label">Label</label>
                    <input id="window-label" class="field__control" @bind="_formLabel" @bind:event="oninput" disabled="@_saving" placeholder="e.g. 7-9 AM" />
                </div>

                <div class="field-grid">
                    <div class="field">
                        <label class="field__label" for="window-starts">Opens</label>
                        <input id="window-starts" class="field__control" type="time" @bind="_formStartsAt" disabled="@_saving" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="window-ends">Closes</label>
                        <input id="window-ends" class="field__control" type="time" @bind="_formEndsAt" disabled="@_saving" />
                    </div>

                    <div class="field">
                        <label class="field__label" for="window-cutoff">Cutoff</label>
                        <div class="input-suffix">
                            <input id="window-cutoff" class="field__control" type="number" min="0" @bind="_formCutoffMinutes" disabled="@_saving" />
                            <span class="input-suffix__unit">min before</span>
                        </div>
                    </div>

                    <div class="field">
                        <label class="field__label" for="window-capacity">Capacity</label>
                        <input id="window-capacity" class="field__control" type="number" min="1" @bind="_formCapacity" disabled="@_saving" />
                    </div>
                </div>

                @if (_editingWindowId is not null)
                {
                    <div class="field field--inline">
                        <input id="window-active" type="checkbox" @bind="_formWindowIsActive" disabled="@_saving" />
                        <label for="window-active">Active</label>
                    </div>
                }

                <div class="op-modal__actions">
                    <button type="button" class="op-btn op-btn--ghost" @onclick="CloseWindowForm" disabled="@_saving">Cancel</button>
                    <button type="button" class="op-btn op-btn--primary" @onclick="SaveWindowAsync" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private ConfirmDialog? _confirmDialog;
    private MarketDto? _market;
    private IReadOnlyList<DeliveryWindowDto> _windows = [];
    private DeliveryWindowDto? _pendingRemoval;
    private bool _notFound;
    private string? _error;
    private string? _pendingGeoJson;
    private bool _savingArea;

    private bool _showMarketForm;
    private bool _showWindowForm;
    private bool _saving;
    private string? _formError;

    private string _formName = string.Empty;
    private string _formAddress = string.Empty;
    private string _formCity = string.Empty;
    private string _formProvince = string.Empty;
    private decimal _formLat;
    private decimal _formLng;
    private string _formStatus = "onboarding";

    private long? _editingWindowId;
    private string _formLabel = string.Empty;
    private TimeOnly _formStartsAt = new(7, 0);
    private TimeOnly _formEndsAt = new(9, 0);
    private int _formCutoffMinutes = 90;
    private int _formCapacity = 20;
    private bool _formWindowIsActive = true;

    /// <summary>Route parameter: the market being inspected.</summary>
    [Parameter]
    public long MarketId { get; set; }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;

        try
        {
            _market = await Api.GetAsync<MarketDto>($"/api/admin/markets/{MarketId}");
            _pendingGeoJson = _market.ServiceAreaGeoJson;
            _windows = await Api.GetAsync<IReadOnlyList<DeliveryWindowDto>>($"/api/admin/markets/{MarketId}/delivery-windows");
            _notFound = false;
        }
        catch (AdminApiException ex) when (ex.StatusCode == 404)
        {
            _notFound = true;
        }
        catch (AdminApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void OnPolygonChanged(string geoJson)
    {
        _pendingGeoJson = string.IsNullOrEmpty(geoJson) ? null : geoJson;
    }

    private void ClearArea() => _pendingGeoJson = null;

    private async Task SaveAreaAsync()
    {
        if (_market is null)
        {
            return;
        }

        _savingArea = true;
        _error = null;

        try
        {
            _market = await Api.PutAsync<MarketDto>(
                $"/api/admin/markets/{_market.Id}/service-area",
                new UpdateServiceAreaRequest(_pendingGeoJson));
            _pendingGeoJson = _market.ServiceAreaGeoJson;
        }
        catch (AdminApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingArea = false;
        }
    }

    private void OpenEditMarket()
    {
        if (_market is not { } market)
        {
            return;
        }

        _formName = market.Name;
        _formAddress = market.Address;
        _formCity = market.City;
        _formProvince = market.Province;
        _formLat = market.Lat;
        _formLng = market.Lng;
        _formStatus = market.Status;
        _formError = null;
        _showMarketForm = true;
    }

    private void CloseMarketForm()
    {
        if (_saving)
        {
            return;
        }

        _showMarketForm = false;
    }

    private async Task SaveMarketAsync()
    {
        if (_market is null)
        {
            return;
        }

        _saving = true;
        _formError = null;

        try
        {
            _market = await Api.PutAsync<MarketDto>(
                $"/api/admin/markets/{_market.Id}",
                new UpdateMarketRequest(_formName, _formAddress, _formCity, _formProvince, _formLat, _formLng, _formStatus));
            _showMarketForm = false;
        }
        catch (AdminApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenCreateWindow()
    {
        _editingWindowId = null;
        _formLabel = string.Empty;
        _formStartsAt = new TimeOnly(7, 0);
        _formEndsAt = new TimeOnly(9, 0);
        _formCutoffMinutes = 90;
        _formCapacity = 20;
        _formWindowIsActive = true;
        _formError = null;
        _showWindowForm = true;
    }

    private void OpenEditWindow(DeliveryWindowDto window)
    {
        _editingWindowId = window.Id;
        _formLabel = window.Label;
        _formStartsAt = window.StartsAt;
        _formEndsAt = window.EndsAt;
        _formCutoffMinutes = window.CutoffOffsetMinutes;
        _formCapacity = window.Capacity;
        _formWindowIsActive = window.IsActive;
        _formError = null;
        _showWindowForm = true;
    }

    private void CloseWindowForm()
    {
        if (_saving)
        {
            return;
        }

        _showWindowForm = false;
    }

    private async Task SaveWindowAsync()
    {
        if (_market is null)
        {
            return;
        }

        _saving = true;
        _formError = null;

        try
        {
            if (_editingWindowId is { } id)
            {
                await Api.PutAsync<DeliveryWindowDto>(
                    $"/api/admin/delivery-windows/{id}",
                    new UpdateDeliveryWindowRequest(_formLabel, _formStartsAt, _formEndsAt, _formCutoffMinutes, _formCapacity, _formWindowIsActive));
            }
            else
            {
                await Api.PostAsync<DeliveryWindowDto>(
                    $"/api/admin/markets/{_market.Id}/delivery-windows",
                    new CreateDeliveryWindowRequest(_formLabel, _formStartsAt, _formEndsAt, _formCutoffMinutes, _formCapacity));
            }

            _windows = await Api.GetAsync<IReadOnlyList<DeliveryWindowDto>>($"/api/admin/markets/{_market.Id}/delivery-windows");
            _showWindowForm = false;
        }
        catch (AdminApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmRemove(DeliveryWindowDto window)
    {
        _pendingRemoval = window;
        _confirmDialog?.Show(
            title: $"Remove the {window.Label} window?",
            message: "Customers lose this booking slot immediately. Orders already placed inside it are unaffected.",
            confirmText: "Remove window",
            destructive: true);
    }

    private async Task HandleRemoveConfirmed(string reason)
    {
        _ = reason;

        if (_pendingRemoval is not { } window || _market is null)
        {
            return;
        }

        _pendingRemoval = null;
        _error = null;

        try
        {
            await Api.DeleteAsync($"/api/admin/delivery-windows/{window.Id}");
            _windows = await Api.GetAsync<IReadOnlyList<DeliveryWindowDto>>($"/api/admin/markets/{_market.Id}/delivery-windows");
        }
        catch (AdminApiException ex)
        {
            _error = ex.Message;
        }
    }
}
