@*
    Shown when a collection is legitimately empty. Always says what is missing and
    what the operator can do next — never a bare "TODO".
*@

<div class="empty-state @(Compact ? "empty-state--compact" : null)">
    <div class="empty-state__glyph" aria-hidden="true">@Glyph</div>
    <p class="empty-state__title">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="empty-state__description">@Description</p>
    }
    @if (Actions is not null)
    {
        <div class="empty-state__actions">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>Short statement of what is missing, e.g. "No markets configured yet".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Explains how the emptiness gets resolved.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>Decorative glyph. Hidden from assistive technology.</summary>
    [Parameter]
    public string Glyph { get; set; } = "◍";

    /// <summary>Optional call-to-action buttons.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Reduces vertical padding, for empty states nested inside small panels.</summary>
    [Parameter]
    public bool Compact { get; set; }
}
