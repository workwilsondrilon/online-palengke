# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# .env is gitignored - never commit real credentials into it.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=localrootpw
MYSQL_DATABASE=onlinepalengke
MYSQL_USER=palengke
MYSQL_PASSWORD=palengke
# Change if 3306 is already taken by a locally installed MySQL.
MYSQL_HOST_PORT=3306
ADMINER_HOST_PORT=8080

# --- Traefik ---
TRAEFIK_HOST_PORT=80

# --- api / admin-web direct ports (work without any DNS/hosts setup) ---
API_HOST_PORT=5080
ADMIN_HOST_PORT=5090

# --- AWS S3 (bound to Storage:* in the API - see docker-compose.yml) ---
# Real S3 in every environment, including local dev; there is no emulator.
# The api container starts fine with these blank - only upload requests
# fail until AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are filled in. The two
# buckets below already exist (provisioned in Epic 1) - op-dev-private has
# Block Public Access fully on; op-dev-public-assets has a GetObject-only
# public read policy. Use a scoped access key here, not a broad account key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
STORAGE_PUBLIC_BUCKET=op-dev-public-assets
STORAGE_PRIVATE_BUCKET=op-dev-private
